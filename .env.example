# Local build configuration template (do not put real secrets in this file)
# Copy this file to .env and fill values for your own environment.

# Optional: Agora SDK download URL (used when -DWINAUDIO_ENABLE_AGORA_SDK=ON)
WINAUDIO_AGORA_SDK_URL=

# Optional runtime defaults for winaudio_probe rtc mode
WINAUDIO_AGORA_APP_ID=
WINAUDIO_AGORA_CHANNEL=
WINAUDIO_AGORA_UID=
